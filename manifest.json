{
  "manifest_version": 3,
  "version": "0.1.1",
  "name": "Daria’s Hirnyk Timer",
  "short_name": "Daria Timer",
  "description": "Засікає, скільки клієнт чекає на відповідь. Один клік — і час під контролем.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Daria’s Hirnyk Timer — почати відлік"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms", "notifications", "scripting"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    { "resources": ["icons/icon128.png"], "matches": ["<all_urls>"] }
  ],
  "commands": {
    "start-timer": {
      "suggested_key": { "default": "Alt+T", "mac": "Alt+T" },
      "description": "Відкрити таймер та розпочати відлік"
    }
  }
}